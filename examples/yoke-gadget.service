# Computer-side box: present one remote USB/IP device through the OTG port.
# See doc/design/USB-DATAPATH.md (runtime requirements) and ADR 0022.
# Prerequisites:
#   useradd --system --no-create-home --gid yoke yoke-gadget
#   echo 'KERNEL=="raw-gadget", OWNER="yoke-gadget", MODE="0600"' \
#     > /etc/udev/rules.d/70-yoke-raw-gadget.rules
#   modprobe raw_gadget   (CONFIG_USB_RAW_GADGET; bench-unverified on Radxa)
#   unbind any configfs gadget (ADB/NCM) from fcc00000.usb and put the
#   DWC3 port in peripheral/OTG device role.
# Raw Gadget needs the controller's gadget name (dwc3: dwc3-gadget); the
# worker infers it from the UDC's driver, or pass --gadget-driver NAME.
# The agent's usb-gadget driver connects to /run/yoke-gadget/control.sock
# (group yoke). Remove --socket and add --target HOST:PORT/BUSID for a
# standalone bench run without the agent.
# Native worker (ADR 0027): build it (native/README.md), then
# `packaging/zero3e/install.sh computer --native-worker PATH` installs it to
# /usr/local/libexec/yoke and adds yoke-gadget.service.d/20-native-worker.conf,
# which sets Environment=YOKE_GADGET_WORKER=native: the ExecStart below then
# executes it with the same options. Re-running `install.sh computer`
# without the option removes the drop-in.
[Unit]
Description=yoke USB gadget worker (USB/IP to Raw Gadget)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yoke-gadget
Group=yoke
UMask=0007
RuntimeDirectory=yoke-gadget
RuntimeDirectoryMode=0750
ExecStart=/opt/yoke/current/venv/bin/python -m yoke.usb.worker \
    --udc fcc00000.usb --socket /run/yoke-gadget/control.sock --power-ma 500
Restart=always
RestartSec=1
# 78 (EX_CONFIG): a configuration error, e.g. YOKE_GADGET_WORKER=native
# without the native binary installed. Restarting cannot fix it.
RestartPreventExitStatus=78
# A stopped worker closes /dev/raw-gadget: the computer sees a disconnect.
KillSignal=SIGTERM
TimeoutStopSec=10s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/raw-gadget rw
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
