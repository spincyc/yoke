# Follow DEPLOYMENT.md to install the package under /opt/yoke/current/venv,
# create the yoke account, configure /etc/yoke, and commission state once.
# Install this unit and yoke-update-recover.service, then:
#   systemctl enable --now yoked
#
# The agent itself never needs privileges. USB/IP endpoints use root-owned
# single-purpose units and drop-ins from packaging/zero3e/ (ADR 0024); never
# add capabilities or User=root here.
[Unit]
Description=yoke endpoint agent
Requires=yoke-update-recover.service
# Ordered after time synchronization when a site enables a time-wait unit,
# but never dependent on it: an RTC-less box with no NTP still starts, and
# admission recovers when the clock is stepped later (ADR 0023).
After=network.target yoke-update-recover.service time-sync.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90s
User=yoke
Group=yoke
UMask=0077
ExecStart=/opt/yoke/current/venv/bin/python -m yoke.cli agent --config /etc/yoke/agent.toml
Restart=always
RestartSec=2
# Crash-only by design: state persists before acks; convergence is
# re-established from the network on every start. Logs go to the journal
# with priorities; set Environment=YOKE_LOG_LEVEL=debug to troubleshoot.
StateDirectory=yoke
StateDirectoryMode=0700
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/var/lib/yoke

[Install]
WantedBy=multi-user.target
