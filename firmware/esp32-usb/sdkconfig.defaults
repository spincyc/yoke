# Yoke USB box, ESP32-S3 (tier 1) and ESP32-P4 (tier 1.5). The target comes
# from the build command (-D IDF_TARGET=...); see README.md.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# CONFIG_ESP_TLS_SERVER_MIN_AUTH_MODE_OPTIONAL is not set
# The native USB PHY belongs to the OTG controller: the console is UART0
# (the board's "UART" connector), never USB-Serial-JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_ESP_WIFI_ENABLED is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Task watchdog panics (and leaves a core dump) on a wedged subscribed task:
# idle tasks, app_main, both USB host tasks, the TinyUSB task (fed by a
# queued tick) and a probe-fed HTTPS server user.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_LWIP_MAX_SOCKETS=16
# The USB Host Library enumerates through this buffer: configuration
# descriptors up to 1 KiB (composite HID, serial with IADs), not 256 B.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
# SNTP for YWP/1's wall clock: one server from DHCP option 42 (index 0),
# one from CONFIG_YOKE_USB_NTP_SERVER.
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
# USB DMA reads any heap buffer: keep RTC fast memory (not DMA-capable)
# out of the heap.
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
