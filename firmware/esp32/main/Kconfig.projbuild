menu "Yoke W5500 Ethernet reference board (bench-unverified)"
config YOKE_ETH_MOSI
    int "W5500 MOSI GPIO"
    default 11
config YOKE_ETH_MISO
    int "W5500 MISO GPIO"
    default 12
config YOKE_ETH_SCLK
    int "W5500 clock GPIO"
    default 13
config YOKE_ETH_CS
    int "W5500 chip select GPIO"
    default 14
config YOKE_ETH_INT
    int "W5500 interrupt GPIO"
    default 10
config YOKE_ETH_RESET
    int "W5500 reset GPIO"
    default 9
config YOKE_ETH_SPI_MHZ
    int "W5500 SPI MHz"
    range 1 40
    default 20
config YOKE_STATIC_IPV4
    bool "Use static IPv4 instead of DHCP"
    default n
config YOKE_IP
    string "Static IPv4 address"
    depends on YOKE_STATIC_IPV4
    default "192.168.20.50"
config YOKE_MASK
    string "Static IPv4 netmask"
    depends on YOKE_STATIC_IPV4
    default "255.255.255.0"
config YOKE_GATEWAY
    string "Static IPv4 gateway (0.0.0.0 allowed)"
    depends on YOKE_STATIC_IPV4
    default "0.0.0.0"
endmenu
