[Unit]
Description=Mark active RAUC slot good after SSH and Yoke health checks
After=network-online.target sshd.service yoke-data-init.service yoked.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/yoke-zero3e-mark-good

[Install]
WantedBy=multi-user.target
