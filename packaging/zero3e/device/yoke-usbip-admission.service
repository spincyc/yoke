# Root helper: apply the USB/IP data-plane allowlist (ADR 0024).
# Runs at boot before usbipd with no request (port closed to the LAN), and
# whenever the agent rewrites /run/yoke/usbip-admission.json (path unit).
# It validates the request, renders one fixed `inet yoke_usbip` nftables
# table for TCP @PORT@ only, loads it atomically, and reports the applied
# allowlist in /run/yoke-admission/status.json for the agent to read.
# ⚠ bench-unverified: real nftables effect on the ZERO 3E kernel.
[Unit]
Description=yoke USB/IP data-plane admission (nftables allowlist)
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service
Before=yoke-usbipd.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/opt/yoke/current/venv/bin/python -m yoke.cli usbip-admission apply --port @PORT@
RuntimeDirectory=yoke-admission
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
# Exactly one capability: loading nftables rules.
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
